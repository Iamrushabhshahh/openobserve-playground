# Copy to .env and set your own values:  cp .env.example .env
#
# Root login. OpenObserve reads these only on the FIRST start with an empty ./data.
# After that, change the password in the UI (IAM -> Users).
# Password rule (the server will not start otherwise): 8-128 characters with at least
# one lowercase letter, one uppercase letter, one digit and one special character.
ZO_ROOT_USER_EMAIL=admin@example.com
ZO_ROOT_USER_PASSWORD=Playground-2026-ChangeMe

# Optional: another image or version.
#   Open-source build:  O2_IMAGE=public.ecr.aws/zinclabs/openobserve:v1.1.1
#   Latest enterprise:  O2_IMAGE=public.ecr.aws/zinclabs/openobserve-enterprise:latest
# O2_IMAGE=

# Optional: run on another port, or next to another OpenObserve on this machine.
# A second playground needs all three, or Docker treats it as the first one and replaces it.
# O2_PORT=5090
# O2_CONTAINER=openobserve-2
# O2_PROJECT=openobserve-2

# Do not send anonymous usage telemetry to OpenObserve.
ZO_TELEMETRY=false
